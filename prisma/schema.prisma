  @@unique([tenantId, code])
  @@index([tenantId])
}

model TillShift {
  id             String          @id @default(cuid())
  tenantId       String
  storeId        String
  openedByUserId String
  closedByUserId String?
  openedAt       DateTime
  closedAt       DateTime?
  openingFloat   Decimal         @default(0)
  closingFloat   Decimal?
  status         TillShiftStatus @default(open)
  events         PosEvent[]
  sales          PosSale[]
  sessions       PosSession[]
  variances      PosVariance[]
  store          Store           @relation(fields: [storeId], references: [id])

  @@index([tenantId, storeId, openedAt])
}

model PosSale {
  id            String        @id @default(cuid())
  tenantId      String
  storeId       String
  sessionId     String?
  shiftId       String?
  cashierUserId String
  customerId    String?
  saleNumber    String
  status        PosSaleStatus @default(open)
  subtotal      Decimal       @default(0)
  tax           Decimal       @default(0)
  total         Decimal       @default(0)
  currency      String        @default("GBP")
  createdAt     DateTime      @default(now())
  events        PosEvent[]
  lines         PosLine[]
  payments      PosPayment[]
  refunds       PosRefund[]
  session       PosSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  shift         TillShift?    @relation(fields: [shiftId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, saleNumber])
  @@index([tenantId, storeId, createdAt])
  @@index([tenantId, shiftId])
  @@index([tenantId, sessionId])
  @@index([tenantId, customerId])
}

model PosLine {
  id              String  @id @default(cuid())
  tenantId        String
  saleId          String
  sku             String
  name            String
  qty             Decimal
  unitPrice       Decimal
  taxRate         Decimal @default(0)
  lineTotal       Decimal
  inventoryItemId String?
  sale            PosSale @relation(fields: [saleId], references: [id])

  @@index([tenantId, saleId])
}

model PosPayment {
  id                    String           @id @default(cuid())
  tenantId              String
  saleId                String
  method                PosPaymentMethod
  amount                Decimal
  tip                   Decimal?
  stripePaymentIntentId String?
  stripeChargeId        String?
  createdAt             DateTime         @default(now())
  sale                  PosSale          @relation(fields: [saleId], references: [id])

  @@index([tenantId, saleId])
  @@index([tenantId, stripePaymentIntentId])
}

model PosRefund {
  id             String   @id @default(cuid())
  tenantId       String
  saleId         String
  amount         Decimal
  reason         String?
  stripeRefundId String?
  createdAt      DateTime @default(now())
  sale           PosSale  @relation(fields: [saleId], references: [id])

  @@index([tenantId, saleId])
  @@index([tenantId, stripeRefundId])
}

model PosEvent {
  id        String     @id @default(cuid())
  tenantId  String
  saleId    String?
  shiftId   String?
  type      String
  payload   Json
  createdAt DateTime   @default(now())
  sale      PosSale?   @relation(fields: [saleId], references: [id])
  shift     TillShift? @relation(fields: [shiftId], references: [id])

  @@index([tenantId, saleId, createdAt])
  @@index([tenantId, shiftId, createdAt])
}

model accounts {
  id                  String  @id
  userId              String
  type                String?
  provider            String?
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user_id             String?
  provider_account_id String?
  User                User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model auth_debug {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  event      String?
  provider   String?
  account_id String?
  user_id    String?
  email      String?
  error      String?
  raw        Json?
}

model password_reset_tokens {
  id         String   @id
  userId     String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  User       User     @relation(fields: [userId], references: [id])
}

model sessions {
  id            String   @id
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  session_token String?
  user_id       String?
  User          User     @relation(fields: [userId], references: [id])
}

model tenant_keys {
  tenant_id  String    @id
  enc_key    Bytes
  alg        String    @default("AES-256-GCM")
  version    Int       @default(1)
  rotated_at DateTime? @default(now()) @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model verification_token {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

