{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x",
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "regions": ["iad1"]
}
