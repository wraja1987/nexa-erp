export const dynamic = "force-dynamic";
export const revalidate = 0;
export const fetchCache = "force-no-store";

import Page from "@/components/layout/Page";
import KpiCard from "@/components/ui/KpiCard";
import NotAuthorised from "../../../../components/NotAuthorised";
import { requirePermissionServer } from "@/lib/auth/guards.server";

export default async function FinanceReportsPage() {
  try {
    // Use the explicit UI permission so ADMIN and SUPER_ADMIN are authorised
    await requirePermissionServer("ui:finance_reports:view");
  } catch {
    // For UI routes, render a friendly Not authorised page (HTTP 200)
    return <NotAuthorised />;
  }

  return (
    <Page title="Finance Reports">
      <div className="grid grid-cols-1 gap-4">
        <KpiCard title="Reports" value="OK" trend="-" />
      </div>
    </Page>
  );
}
export const dynamic = "force-dynamic";
export const revalidate = 0;
export const fetchCache = "force-no-store";

import Page from "@/components/layout/Page";
import NotAuthorised from '../../../../components/NotAuthorised';
import { auth } from "@/lib/auth"; // NextAuth server helper

export default async function FinanceReportsPage() {
  const session = await auth();
  const role = (session?.user as any)?.role;
  const isAdmin = role === "ADMIN";

  if (!isAdmin) {
    // IMPORTANT: render 200 with NotAuthorised — do NOT throw or notFound()
    return <NotAuthorised />;
  }

  return (
    <Page title="Finance Reports">
      <div className="grid grid-cols-1 gap-6">
        {/* stub content; replace with real report widgets as needed */}
        <div className="rounded border p-6">
          <h2 className="text-lg font-medium">Reports</h2>
          <p className="mt-2 text-sm text-gray-600">Admin-only finance reporting area.</p>
        </div>
      </div>
    </Page>
  );
}
